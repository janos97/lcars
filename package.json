{
  "name": "lcars",
  "version": "1.0.0",
  "description": "A framework-agnostic LCARS design system: CSS tokens, layout frames, components and an optional tiny JS helper.",
  "type": "module",
  "style": "dist/lcars.css",
  "main": "dist/lcars.js",
  "exports": {
    ".": {
      "style": "./dist/lcars.css",
      "default": "./dist/lcars.js"
    },
    "./lcars.css": "./dist/lcars.css",
    "./lcars.min.css": "./dist/lcars.min.css",
    "./lcars.js": "./dist/lcars.js",
    "./fonts/*": "./dist/fonts/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./dist/lcars.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "lcars",
    "star-trek",
    "css",
    "design-system",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/janos97/lcars.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0"
  }
}
